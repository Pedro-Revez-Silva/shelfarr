<section class="mt-6 rounded-lg border border-gray-800 bg-gray-900 p-6" aria-labelledby="manual-match-heading">
  <h2 id="manual-match-heading" class="text-xl font-semibold text-white">Correct the match and retry</h2>
  <p class="mt-2 text-sm text-gray-400">Choose a local <%= @upload.infer_book_type.to_s.humanize.downcase %> or create one with corrected details. Shelfarr will keep your choice on retries and skip automatic metadata matching. Existing library files are preserved.</p>

  <%= form_with url: admin_upload_path(@upload), method: :get, class: "mt-5" do |form| %>
    <%= form.label :q, "Search local books by title or author", class: "block text-sm font-medium text-gray-200" %>
    <div class="mt-2 flex flex-wrap gap-2">
      <%= form.search_field :q, value: @match_query, class: "min-w-0 flex-1 rounded-md border-gray-700 bg-gray-800 text-white" %>
      <%= form.submit "Search books", class: "rounded-md bg-gray-700 px-4 py-2 text-sm font-medium text-white hover:bg-gray-600 cursor-pointer" %>
    </div>
  <% end %>
  <p class="mt-2 text-xs text-gray-400">Only books with the same format and no library file or acquisition in progress are shown.</p>

  <ul class="mt-3 divide-y divide-gray-800">
    <% @match_books.first(20).each do |book| %>
      <li class="flex flex-wrap items-center justify-between gap-3 py-3">
        <div class="min-w-0 break-words text-sm text-gray-200"><%= book.display_name %></div>
        <%= button_to "Select and retry", match_and_retry_admin_upload_path(@upload), params: { book_id: book.id },
            class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500",
            aria: { label: "Select #{book.display_name} and retry" } %>
      </li>
    <% end %>
  </ul>
  <% if @match_books.empty? %>
    <p class="mt-3 text-sm text-gray-400">No available books found. Try another search or create a book below.</p>
  <% elsif @match_books.size > 20 %>
    <p class="mt-3 text-sm text-gray-400">Showing the first 20 matches. Refine your search to find another book.</p>
  <% end %>

  <details class="mt-5 border-t border-gray-800 pt-5" <%= "open" if params[:manual_book].present? %>>
    <summary class="cursor-pointer font-medium text-gray-200">Create a book with corrected details</summary>
    <%= form_with scope: :manual_book, url: match_and_retry_admin_upload_path(@upload), class: "mt-4 space-y-4" do |form| %>
      <div>
        <%= form.label :title, "Title", class: "block text-sm font-medium text-gray-200" %>
        <%= form.text_field :title, value: @manual_book.title, required: true, class: "mt-1 block w-full rounded-md border-gray-700 bg-gray-800 text-white" %>
      </div>
      <div>
        <%= form.label :author, "Author (optional)", class: "block text-sm font-medium text-gray-200" %>
        <%= form.text_field :author, value: @manual_book.author, class: "mt-1 block w-full rounded-md border-gray-700 bg-gray-800 text-white" %>
      </div>
      <%= form.submit "Create book and retry", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
    <% end %>
  </details>
</section>
