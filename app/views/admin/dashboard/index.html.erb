<% content_for :title, "Server overview · Shelfarr" %>
<% health_issues = SystemHealth::SERVICES.filter_map { |service| [ service, @system_health[service] ] if health_issue?(@system_health[service]) } %>
<% repository = SettingsService.get(:github_repo).presence || "Pedro-Revez-Silva/shelfarr" %>
<% image = "ghcr.io/#{repository.downcase}" %>

<div class="mx-auto max-w-5xl space-y-8">
  <header>
    <h1 class="font-bold text-4xl text-white">Server overview</h1>
    <p class="mt-2 text-sm text-gray-400">Health, release and settings for everyone on this Shelfarr server. Only admins can see this page.</p>
  </header>

  <section aria-labelledby="attention-heading" class="rounded-lg border <%= health_issues.any? || @attention_needed > 0 || @update_check&.update_available? ? 'border-amber-700/60 bg-amber-950/20' : 'border-gray-800 bg-gray-900' %> p-6">
    <h2 id="attention-heading" class="font-bold text-xl text-white">Needs attention</h2>
    <% if health_issues.empty? && @attention_needed.zero? && !@update_check&.update_available? %>
      <p class="mt-2 text-sm text-gray-400">Nothing needs attention from the last health check.</p>
    <% else %>
      <ul class="mt-4 space-y-3">
        <% health_issues.each do |service, health| %>
          <% fix = health_fix(service) %>
          <li class="flex flex-col gap-2 rounded-md bg-gray-900/70 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <p class="font-medium text-gray-100"><%= health_service_label(service) %> is <%= health.status == "down" ? "down" : "degraded" %></p>
              <% if health.message.present? %>
                <p class="break-words text-sm text-gray-400"><%= health.message %></p>
              <% end %>
            </div>
            <% if fix %>
              <%= link_to "Open #{fix.label}", fix.path, class: "shrink-0 rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
            <% end %>
          </li>
        <% end %>
        <% if @attention_needed > 0 %>
          <li class="flex flex-col gap-2 rounded-md bg-gray-900/70 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="font-medium text-gray-100"><%= pluralize(@attention_needed, "request") %> <%= @attention_needed == 1 ? "needs" : "need" %> attention</p>
            <%= link_to "Review requests", requests_path(attention: "true"), class: "shrink-0 rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
          </li>
        <% end %>
        <% if @update_check&.update_available? %>
          <li class="flex flex-col gap-2 rounded-md bg-gray-900/70 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="font-medium text-gray-100">Version <%= @update_check.latest_version %> is available</p>
            <%= link_to "See release and backup steps", "#release", class: "shrink-0 rounded-md bg-gray-700 px-3 py-2 text-sm font-medium text-gray-100 hover:bg-gray-600" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="rounded-lg border border-gray-800 bg-gray-900 p-4">
      <div class="text-sm font-medium text-gray-400">Users</div>
      <div class="text-3xl font-bold text-blue-400"><%= @total_users %></div>
    </div>
    <div class="rounded-lg border border-gray-800 bg-gray-900 p-4">
      <div class="text-sm font-medium text-gray-400">Books</div>
      <div class="text-3xl font-bold text-green-400"><%= @total_books %></div>
    </div>
    <div class="rounded-lg border border-gray-800 bg-gray-900 p-4">
      <div class="text-sm font-medium text-gray-400">Pending requests</div>
      <div class="text-3xl font-bold text-purple-400"><%= @pending_requests %></div>
    </div>
    <div class="rounded-lg border border-gray-800 bg-gray-900 p-4">
      <div class="text-sm font-medium text-gray-400">Need attention</div>
      <div class="text-3xl font-bold <%= @attention_needed > 0 ? 'text-red-400' : 'text-gray-500' %>"><%= @attention_needed %></div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <section id="system-health" aria-labelledby="system-health-heading" class="rounded-lg border border-gray-800 bg-gray-900 p-6">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h2 id="system-health-heading" class="font-bold text-xl text-white">System health</h2>
        <%= button_to "Run check", admin_run_health_check_path, method: :post, class: "rounded bg-gray-700 px-3 py-1 text-sm text-gray-200 hover:bg-gray-600" %>
      </div>
      <ul>
        <% SystemHealth::SERVICES.each do |service| %>
          <% health = @system_health[service] %>
          <% fix = health_fix(service) %>
          <li class="flex items-start justify-between gap-4 border-b border-gray-800 py-3 last:border-b-0">
            <div class="min-w-0">
              <span class="font-medium text-gray-200"><%= health_service_label(service) %></span>
              <span class="block text-xs text-gray-500">
                <%= health&.last_check_at ? "Checked #{time_ago_in_words(health.last_check_at)} ago" : "Not checked yet" %>
              </span>
              <% if fix %>
                <%= link_to fix.label, fix.path, class: "text-xs text-blue-400 hover:text-blue-300" %>
              <% end %>
            </div>
            <div class="min-w-0 text-right">
              <% if health %>
                <span class="rounded px-2 py-1 text-sm <%=
                  case health.status
                  when 'healthy' then 'bg-green-900/50 text-green-400'
                  when 'degraded' then 'bg-yellow-900/50 text-yellow-400'
                  when 'down' then 'bg-red-900/50 text-red-400'
                  else 'bg-gray-700 text-gray-300'
                  end
                %>"><%= health.status.humanize %></span>
                <% if health.message.present? %>
                  <span class="mt-1 block break-words text-xs text-gray-500"><%= health.message %></span>
                <% end %>
              <% else %>
                <span class="rounded bg-gray-700 px-2 py-1 text-sm text-gray-300">Not checked</span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>

    <section id="release" aria-labelledby="release-heading" class="rounded-lg border border-gray-800 bg-gray-900 p-6">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h2 id="release-heading" class="font-bold text-xl text-white">Release</h2>
        <%= button_to "Check for updates", admin_check_updates_path, method: :post, class: "rounded bg-gray-700 px-3 py-1 text-sm text-gray-200 hover:bg-gray-600" %>
      </div>
      <p class="text-lg font-semibold text-white"><%= release_channel.label %></p>
      <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
        <dt class="text-gray-500">Build</dt>
        <dd class="break-all text-gray-200"><%= Consumer::ServerInfo.server_version %></dd>
        <dt class="text-gray-500">Updates</dt>
        <dd class="text-gray-200"><%= release_channel.beta? ? "Newest beta or stable build" : "Stable releases only" %></dd>
        <dt class="text-gray-500">Latest</dt>
        <dd class="text-gray-200">
          <% if @update_check.nil? %>
            Not checked yet
          <% elsif @update_check.update_available? %>
            <%= @update_check.latest_version %> is available
            <% if @update_check.release_url.present? %>
              · <%= link_to "Release notes", @update_check.release_url, target: "_blank", rel: "noopener", class: "text-blue-400 hover:text-blue-300" %>
            <% end %>
          <% elsif @update_check.latest_version.present? %>
            You're up to date
          <% else %>
            Couldn't check<%= ": #{@update_check.latest_message}" if @update_check.latest_message.present? %>
          <% end %>
        </dd>
      </dl>
      <% if release_channel.beta? %>
        <p class="mt-4 text-sm text-gray-300">This is a beta. It is ready to use, but some screens may still change before Shelfarr <%= release_channel.series %> is final.</p>
      <% end %>
      <details class="mt-4 text-sm">
        <summary class="cursor-pointer text-blue-400 hover:text-blue-300">How to update or go back safely</summary>
        <div class="mt-2 space-y-2 text-gray-400">
          <p>Stop Shelfarr and back up its storage volume (<code class="break-all">/rails/storage</code>) before every update.</p>
          <p>Docker Compose, with <code class="break-all">SHELFARR_VERSION=<%= release_channel.image_channel_tag %></code>:</p>
          <pre class="overflow-x-auto rounded bg-gray-950 p-2 text-xs text-gray-300">docker compose pull && docker compose up -d</pre>
          <p>Docker CLI:</p>
          <pre class="overflow-x-auto rounded bg-gray-950 p-2 text-xs text-gray-300">docker pull <%= image %>:<%= release_channel.image_channel_tag %></pre>
          <p>Database changes made by a newer build stay when you switch the image back. To go back, restore the backup you made, then start the earlier build.</p>
          <p><%= link_to "Releases, backups and rollback", "https://github.com/#{repository}/blob/main/docs/releases.md", target: "_blank", rel: "noopener", class: "text-blue-400 hover:text-blue-300" %></p>
        </div>
      </details>
    </section>
  </div>

  <section aria-labelledby="settings-heading">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <h2 id="settings-heading" class="font-bold text-xl text-white">Server settings</h2>
      <%= link_to "All Settings", admin_settings_path, class: "text-sm text-blue-400 hover:text-blue-300" %>
    </div>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% Admin::SettingsHelper::SETTINGS_TABS.each do |tab, config| %>
        <li>
          <%= link_to admin_settings_path(anchor: tab), class: "block h-full rounded-lg border border-gray-800 bg-gray-900 p-4 hover:border-gray-600" do %>
            <span class="block font-medium text-white"><%= config[:label] %></span>
            <span class="mt-1 block text-sm text-gray-400"><%= config[:summary] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <section aria-labelledby="manage-heading">
    <h2 id="manage-heading" class="mb-4 font-bold text-xl text-white">Manage</h2>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% [
        [ "Users", admin_users_path ],
        [ "Download Clients", admin_download_clients_path ],
        [ "Acquisition Providers", admin_acquisition_providers_path ],
        [ "Download Routing", admin_download_routing_rules_path ],
        [ "Audible Backup (Beta)", admin_owned_library_connections_path ],
        [ "Manual Uploads", admin_uploads_path ],
        [ "Book files", library_index_path ],
        [ "Activity Log", admin_activity_logs_path ]
      ].each do |label, path| %>
        <li><%= link_to label, path, class: "block rounded-lg border border-gray-800 bg-gray-900 px-4 py-3 text-gray-200 hover:border-gray-600" %></li>
      <% end %>
      <li>
        <%= button_to "Run setup again", restart_admin_setup_wizard_path, method: :post, form_class: "h-full", class: "block w-full rounded-lg border border-gray-800 bg-gray-900 px-4 py-3 text-left text-gray-200 hover:border-gray-600" %>
      </li>
    </ul>
  </section>
</div>
