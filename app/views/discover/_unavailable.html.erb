<div class="rounded-lg border border-gray-800 bg-gray-900 p-8 text-center" role="status">
  <p class="text-lg font-medium text-gray-200">Discovery needs Hardcover access</p>
  <p class="mx-auto mt-2 max-w-xl text-sm text-gray-400">
    Shelfarr reads Hardcover's public catalog with the instance Hardcover API token, or with your own connected Hardcover account.
  </p>
  <div class="mt-5 flex flex-wrap justify-center gap-3">
    <% if Current.user.admin? %>
      <%= link_to "Add a Hardcover token in Settings", admin_settings_path, class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-500" %>
    <% end %>
    <% if HardcoverIntegration.connection_available? %>
      <%= link_to "Connect your Hardcover account", profile_path(anchor: "hardcover"), class: "rounded-lg bg-gray-700 px-4 py-2 text-sm font-medium text-gray-200 transition hover:bg-gray-600" %>
    <% elsif !Current.user.admin? %>
      <p class="text-sm text-gray-500">Ask an administrator to configure Hardcover.</p>
    <% end %>
  </div>
</div>
