<%
  hardcover = controller_path == "search" ? hardcover_catalog_available? : HardcoverIntegration.enabled?
  tabs = [ [ "Search", search_path, "search" ] ]
  if hardcover
    tabs += [
      [ "Books", discover_path, "index" ],
      [ "Lists", discover_lists_path, "lists list" ],
      [ "Authors", discover_authors_path, "authors author" ],
      [ "Following", hardcover_subscriptions_path, "following" ]
    ]
  end
  current = case controller_path
  when "hardcover/subscriptions" then "following"
  when "search" then "search"
  when "discover" then action_name
  end
%>
<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h1 class="text-3xl font-bold text-white">Discover</h1>
    <p class="mt-1 text-sm text-gray-400">
      <% if hardcover %>
        Search metadata sources, or browse books, public lists, and authors from Hardcover, then request what you want to read.
      <% else %>
        Search metadata sources for books, comics and manga, then request what you want to read.
      <% end %>
    </p>
  </div>
  <%= hardcover_attribution if hardcover && controller_path != "search" %>
</div>
<nav class="mb-6 flex gap-1 overflow-x-auto border-b border-gray-800" aria-label="Discover sections">
  <% tabs.each do |label, path, actions| %>
    <% active = current.present? && actions.split.include?(current) %>
    <%= link_to label, path,
      class: "whitespace-nowrap border-b-2 px-4 py-3 text-sm font-medium transition #{active ? 'border-blue-500 text-blue-400' : 'border-transparent text-gray-400 hover:border-gray-600 hover:text-gray-300'}",
      aria: { current: (active ? "page" : nil) } %>
  <% end %>
</nav>
