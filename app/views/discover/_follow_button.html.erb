<%# locals: (kind:, target_id:, subscription:, label:) %>
<% if subscription %>
  <%= link_to subscription.draft? ? "Continue preview" : "Following · manage", hardcover_subscription_path(subscription),
    class: "inline-flex items-center rounded-lg bg-gray-700 px-4 py-2 text-sm font-medium text-gray-100 transition hover:bg-gray-600" %>
<% else %>
  <%= button_to label, hardcover_subscriptions_path,
    params: { kind: kind, hardcover_target_id: target_id },
    class: "inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-500 cursor-pointer" %>
<% end %>
