<% content_for :title, "#{@book.title} · Shelfarr" %>
<% content_for :hide_navigation, "true" %>
<% reading = @book.ebook? && @publication[:assets].any? %>
<% content_for :main_class, reading ? "consumer-publication consumer-reading" : "consumer-publication" %>
<% content_for :reading_mode, "true" if reading %>
<% status_form = capture do %>
  <%= form_with url: consumer_reading_status_path(@book), method: :put, class: "consumer-reading-status", data: { action: "submit->consumer-reader#saveReadingStatus", turbo: false } do |form| %>
    <label>Reading status<%= form.select :status, [["Unread", "unread"], ["Reading", "in_progress"], ["Finished", "finished"]], selected: @publication[:reading_status] %></label>
    <%= form.submit "Save status", class: "consumer-button consumer-button--subtle" %>
    <span role="status">Your saved place is kept.</span>
  <% end %>
<% end %>
<% conflict = capture do %>
  <div class="consumer-conflict" data-consumer-reader-target="conflict" hidden role="alert"><p data-consumer-reader-target="conflictMessage">Another device saved a different place. Which place would you like to keep?</p><button type="button" data-action="consumer-reader#useServerProgress">Use other device's place</button><button type="button" data-action="consumer-reader#keepLocalProgress">Keep this place</button></div>
<% end %>
<% if reading %>
  <div data-controller="consumer-reader" class="consumer-reading-session consumer-reading-session--ebook" data-action="keydown->consumer-reader#readerKey">
    <script type="application/json" data-consumer-reader-target="publication"><%= raw json_escape(@publication.to_json) %></script>
    <section class="consumer-reader" aria-label="<%= @book.title %>">
      <button type="button" class="consumer-controls-reveal" data-consumer-reader-target="reveal" data-action="consumer-reader#showControls" aria-controls="consumer-reader-controls" aria-expanded="false">Show reading controls</button>
      <div class="consumer-ebook-frame" data-action="click->consumer-reader#marginTap">
        <div class="consumer-ebook" data-consumer-reader-target="viewport" tabindex="0" aria-label="Book text. Arrow keys turn pages; Escape shows reading controls."><p class="consumer-opening">Opening your book…</p></div>
      </div>
      <div id="consumer-reader-controls" class="consumer-reader-controls" data-consumer-reader-target="controls" role="region" aria-label="Reading controls" hidden>
        <div class="consumer-reader-controls__top">
          <%= link_to "← Your library", consumer_library_path, class: "consumer-back" %>
          <p class="consumer-reader-title"><span><%= @book.title %></span><% if @book.author.present? %> <small><%= @book.author %></small><% end %></p>
          <button type="button" class="consumer-reader-done" data-consumer-reader-target="hide" data-action="consumer-reader#hideControls">Done</button>
        </div>
        <div class="consumer-reader-controls__bottom">
          <div class="consumer-page-controls"><button type="button" data-action="consumer-reader#previousPage">← Previous</button><span data-consumer-reader-target="location">Your place</span><button type="button" data-action="consumer-reader#nextPage">Next →</button></div>
          <div class="consumer-reader-toolbar">
            <label class="consumer-chapters">Chapter<select data-consumer-reader-target="chapters" data-action="change->consumer-reader#chooseChapter"><option>Opening book…</option></select></label>
            <div class="consumer-type-controls" role="group" aria-label="Text size"><button type="button" data-action="consumer-reader#smallerText" aria-label="Smaller text">A−</button><button type="button" data-action="consumer-reader#largerText" aria-label="Larger text">A+</button></div>
          </div>
          <div class="consumer-sync"><span data-consumer-reader-target="syncStatus" role="status">Your place is kept on this device and saved to your account</span><button type="button" data-action="consumer-reader#retrySync" data-consumer-reader-target="retry" hidden>Retry</button></div>
          <%= status_form %>
        </div>
      </div>
      <div class="consumer-reader-notices">
        <p class="consumer-reader-notice" data-consumer-reader-target="notice" role="status" hidden></p>
        <div class="consumer-reader-notice consumer-reader-notice--remote" data-consumer-reader-target="remote" hidden role="status"><span>Another device has a more recent place.</span><button type="button" data-action="consumer-reader#goToRemote">Go there</button></div>
        <%= conflict %>
        <p class="consumer-reader-error" data-consumer-reader-target="error" hidden role="alert"></p>
      </div>
    </section>
  </div>
<% else %>
  <%= link_to "← Your library", consumer_library_path, class: "consumer-back" %>
  <div data-controller="consumer-reader" class="consumer-reading-session">
    <script type="application/json" data-consumer-reader-target="publication"><%= raw json_escape(@publication.to_json) %></script>
    <section class="consumer-publication-heading">
      <%= render "cover", book: @book, publication: @publication %>
      <div><p class="consumer-eyebrow"><%= @book.ebook? ? "Make room for a chapter" : "A story for your day" %></p><span class="consumer-format"><%= @book.ebook? ? "Ebook" : "Audiobook" %></span><h1><%= @book.title %></h1><p class="consumer-author"><%= @book.author %></p><p class="consumer-description"><%= truncate(strip_tags(@book.description.to_s), length: 380) %></p></div>
    </section>
    <% if @publication[:assets].empty? %>
      <div class="consumer-empty"><h2>No readable files are available</h2><p>The file may be missing or use an unsupported format. Ask a server administrator to check the library file or import it again. Your saved place is kept.</p><div class="consumer-recovery"><%= link_to "Check again", consumer_publication_path(@book), class: "consumer-button" %><%= link_to "Back to your library", consumer_library_path, class: "consumer-button consumer-button--subtle" %></div></div>
    <% else %>
      <div class="consumer-sync"><span data-consumer-reader-target="syncStatus" role="status">Your place is kept on this device and saved to your account</span><button type="button" data-action="consumer-reader#retrySync" data-consumer-reader-target="retry" hidden>Retry</button></div>
      <%= conflict %>
      <div class="consumer-reader-notice consumer-reader-notice--remote" data-consumer-reader-target="remote" hidden role="status"><span>Another device has a more recent place.</span><button type="button" data-action="consumer-reader#goToRemote">Go there</button></div>
      <p class="consumer-reader-error" data-consumer-reader-target="error" hidden role="alert"></p>
      <section class="consumer-audio-panel" aria-label="Audiobook player">
        <div class="consumer-audio-identity"><span class="consumer-now-playing">Now playing</span><h2 data-consumer-reader-target="trackTitle"><%= @publication[:assets].first[:filename] %></h2></div>
        <audio data-consumer-reader-target="audio" preload="metadata" data-action="loadedmetadata->consumer-reader#audioLoaded timeupdate->consumer-reader#audioPosition pause->consumer-reader#audioPaused ended->consumer-reader#nextTrack error->consumer-reader#audioError"></audio>
        <div class="consumer-audio-timeline"><label for="consumer-seek" class="consumer-sr-only">Listening position</label><input id="consumer-seek" type="range" min="0" max="100" value="0" step="0.1" data-consumer-reader-target="seek" data-action="input->consumer-reader#seekAudio change->consumer-reader#seekCommitted"><div><span data-consumer-reader-target="elapsed">0:00</span><span data-consumer-reader-target="duration">—</span></div></div>
        <div class="consumer-audio-controls"><button type="button" data-action="consumer-reader#backwardAudio" aria-label="Rewind 15 seconds">↶<small>15</small></button><button type="button" class="consumer-play" data-action="consumer-reader#toggleAudio" data-consumer-reader-target="play" aria-label="Play audiobook">▶</button><button type="button" data-action="consumer-reader#forwardAudio" aria-label="Forward 30 seconds">↷<small>30</small></button></div>
        <div class="consumer-audio-options"><label>Speed<select data-consumer-reader-target="speed" data-action="change->consumer-reader#changeSpeed"><option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option><option value="2">2×</option></select></label><label>Track<select data-consumer-reader-target="tracks" data-action="change->consumer-reader#chooseTrack"><% @publication[:assets].each_with_index do |asset, index| %><option value="<%= index %>"><%= asset[:filename] %></option><% end %></select></label></div>
        <p class="consumer-player-note">Your browser controls background playback. Your place is kept on this device until it reaches your account.</p>
      </section>
    <% end %>
    <%= status_form %>
  </div>
<% end %>
