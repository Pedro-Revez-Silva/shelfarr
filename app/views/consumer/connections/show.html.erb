<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<div class="mx-auto max-w-lg rounded-xl border border-gray-800 bg-gray-900 p-6 sm:p-8">
  <% if @grant&.pending? && !@grant.decidable_by?(Current.user) %>
    <h1 class="text-2xl font-semibold text-white">Different account</h1>
    <p class="mt-4 text-gray-300" data-consumer-approval="wrong-account">This code belongs to an app that is connected to a different Shelfarr account, so <strong><%= Current.user.name %></strong> can't approve it.</p>
    <p class="mt-3 text-gray-400">Sign out, sign in with the account the app uses, then open the code again. Nothing has changed for either account.</p>
  <% elsif @grant&.pending? %>
    <% if @grant.upgrade? %>
      <h1 class="text-2xl font-semibold text-white">Allow requesting from your app</h1>
      <p class="mt-4 text-gray-300"><strong><%= @grant.client_name %></strong>, already connected as <strong><%= Current.user.name %></strong>, is asking to also request books.</p>
    <% else %>
      <h1 class="text-2xl font-semibold text-white">Connect your Shelfarr app</h1>
      <p class="mt-4 text-gray-300"><strong><%= @grant.client_name %></strong> is asking to connect as <strong><%= Current.user.name %></strong>.</p>
    <% end %>
    <p class="mt-3 text-gray-400">Check that this code matches the one shown in the app you just opened:</p>
    <p class="my-6 text-center text-3xl tracking-widest font-mono text-blue-300"><%= @user_code.upcase %></p>
    <% if @grant.requesting? %>
      <div class="space-y-3 text-sm text-gray-300" data-consumer-approval="requesting">
        <p class="font-medium text-white">If you allow it, the app can:</p>
        <ul class="list-disc space-y-1 pl-5">
          <li>Browse and download your library, and save your reading and listening progress.</li>
          <li><strong class="text-white">Search for titles and request ebooks and audiobooks as <%= Current.user.name %>.</strong> Requests follow this server's usual rules, including duplicate checks.</li>
          <li>See and cancel your own requests.</li>
        </ul>
        <p class="text-gray-400">It cannot see other people's requests, manage users or change server settings. You can revoke it from your Account page.</p>
        <% if @grant.upgrade? %>
          <p class="text-gray-400">If you choose Not now, the app keeps its current read-and-listen access.</p>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-400">The app can browse and download your library and save your reading/listening progress. It cannot request books or manage your server. You can revoke it from your Account page.</p>
    <% end %>
    <p class="mt-3 text-sm text-amber-300">Only approve a connection you started yourself. Do not approve a code someone sent you.</p>
    <%= form_with url: consumer_connect_path, data: { turbo: false }, class: "mt-6 flex flex-wrap gap-3" do |form| %>
      <%= form.hidden_field :user_code, value: @user_code %>
      <button name="decision" value="allow" class="rounded-lg bg-blue-600 px-5 py-3 font-medium text-white hover:bg-blue-500"><%= @grant.upgrade? ? "Allow requesting" : (@grant.requesting? ? "Connect and allow requesting" : "Connect app") %></button>
      <button name="decision" value="deny" class="rounded-lg bg-gray-800 px-5 py-3 text-gray-200 hover:bg-gray-700"><%= @grant.upgrade? ? "Not now" : "Deny" %></button>
    <% end %>
  <% else %>
    <h1 class="text-2xl font-semibold text-white">Connect your Shelfarr app</h1>
    <p class="mt-4 text-gray-400">Enter the code displayed in your Shelfarr app. Codes expire after ten minutes.</p>
    <%= form_with url: consumer_connect_path, method: :get, class: "mt-6 space-y-3" do |form| %>
      <%= form.label :user_code, "Connection code", class: "block text-sm text-gray-300" %>
      <%= form.text_field :user_code, value: @user_code, required: true, maxlength: 32, autocomplete: "off", class: "w-full rounded-lg border border-gray-700 bg-gray-800 px-4 py-3 font-mono text-lg text-white" %>
      <%= form.submit "Check code", class: "rounded-lg bg-blue-600 px-5 py-3 text-white hover:bg-blue-500 cursor-pointer" %>
    <% end %>
  <% end %>
</div>
