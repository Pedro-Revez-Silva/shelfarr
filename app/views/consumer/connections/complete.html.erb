<div class="mx-auto max-w-lg rounded-xl border border-gray-800 bg-gray-900 p-8">
  <% if @allowed && @grant.upgrade? %>
    <h1 class="text-2xl font-semibold text-white">Requesting allowed</h1>
    <p class="mt-4 text-gray-400">Return to the Shelfarr app. It can now find and request books for you; your downloads and saved places are unchanged.</p>
  <% elsif @allowed %>
    <h1 class="text-2xl font-semibold text-white">App connected</h1>
    <p class="mt-4 text-gray-400"><%= @grant.requesting? ? "Return to the Shelfarr app to open your library and request books." : "Return to the Shelfarr app to open your library." %></p>
  <% elsif @grant.upgrade? %>
    <h1 class="text-2xl font-semibold text-white">Requesting not allowed</h1>
    <p class="mt-4 text-gray-400">The app keeps its current read-and-listen access and cannot request books.</p>
  <% else %>
    <h1 class="text-2xl font-semibold text-white">Connection denied</h1>
    <p class="mt-4 text-gray-400">The app was not granted access to your account.</p>
  <% end %>
  <%= link_to "Account", profile_path, class: "mt-6 inline-block text-blue-400 hover:text-blue-300" %>
</div>
