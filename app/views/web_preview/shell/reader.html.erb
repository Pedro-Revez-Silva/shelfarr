<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="robots" content="noindex">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FBF7F0">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#16130F">
    <%= stylesheet_link_tag "web/preview" %>
    <%= javascript_include_tag "web/preview", type: "module" %>
  </head>
  <body class="web-preview">
    <div id="root"><p class="boot-message" role="status">Loading Shelfarr…</p></div>
    <noscript><p class="boot-message">Shelfarr's browser screens need JavaScript. Turn it on for this site and reload; nothing has been changed.</p></noscript>
    <script type="application/json" id="shelfarr-boot"><%= raw json_escape(boot.to_json) %></script>
  </body>
</html>
