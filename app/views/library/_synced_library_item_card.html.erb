<% format_class = case item.book_type
when "audiobook" then "bg-purple-500/90"
when "comicbook" then "bg-pink-500/90"
when "ebook" then "bg-blue-500/90"
when "ebook_or_comic" then "bg-indigo-500/90"
else "bg-gray-600/90"
end %>

<article
  class="group flex h-full flex-col overflow-hidden rounded-xl bg-gray-900 shadow-lg ring-1 ring-gray-800 transition-all duration-300 hover:scale-[1.03] hover:shadow-2xl motion-reduce:transition-none motion-reduce:hover:scale-100"
  data-library-card
  data-library-source="<%= item.library_platform %>"
  data-synced-library-item-id="<%= item.id %>"
>
  <%= link_to synced_library_item_path(item), class: "flex h-full flex-col" do %>
    <div class="relative aspect-[2/3]">
      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-teal-950 via-gray-800 to-gray-950">
        <svg class="h-12 w-12 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>

      <span class="absolute left-2 top-2 rounded bg-teal-600/90 px-2 py-0.5 text-xs font-medium text-white backdrop-blur-sm"><%= item.platform_name %></span>
      <span class="absolute right-2 top-2 rounded px-2 py-0.5 text-xs font-medium text-white backdrop-blur-sm <%= format_class %>"><%= item.book_type_label %></span>
    </div>

    <div class="flex flex-1 flex-col p-3">
      <h3 class="line-clamp-2 text-sm font-semibold leading-tight text-white"><%= item.display_title.presence || "Untitled" %></h3>
      <% if item.display_author.present? %>
        <p class="mt-1 truncate text-xs text-gray-400"><%= item.display_author %></p>
      <% end %>
      <div class="mt-3 flex-1 text-xs">
        <p class="text-teal-300">Available in <%= item.platform_name %></p>
        <% if item.series_label.present? %>
          <p class="mt-1 truncate text-gray-500"><%= item.series_label %></p>
        <% end %>
      </div>
      <span class="mt-3 w-full rounded-md bg-teal-700 px-3 py-2 text-center text-sm font-medium text-white group-hover:bg-teal-600">View details</span>
    </div>
  <% end %>
</article>
