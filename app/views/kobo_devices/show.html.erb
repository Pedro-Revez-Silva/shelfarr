<% tones = { ok: "text-green-300", warning: "text-amber-300", choice: "text-sky-300", info: "text-gray-400" } %>
<div class="mx-auto max-w-3xl space-y-6">
  <%= link_to "← Kobo readers", kobo_devices_path, class: "text-blue-400 hover:text-blue-300" %>
  <div>
    <h1 class="text-3xl font-bold text-white break-words"><%= @device.name %></h1>
    <p class="mt-2 text-gray-400"><%= kobo_mode_label(@device) %> · <%= @device.last_sync_at ? "Last sync request #{time_ago_in_words(@device.last_sync_at)} ago" : "Waiting for first sync from this reader" %></p>
    <% if @device.store_coexistence? %>
      <% store = kobo_store_status(@device) %>
      <p class="mt-2 text-sm <%= tones.fetch(store.tone) %>" data-testid="kobo-store-status" role="status"><%= store.text %></p>
    <% end %>
  </div>
  <section class="rounded-lg border border-gray-800 bg-gray-900 p-6">
    <h2 class="text-xl font-semibold text-white">Selected books</h2>
    <p class="mt-2 mb-4 text-sm text-gray-400">Sync this Kobo over Wi-Fi to receive queued books. A download request does not confirm that the reader finished saving the book.</p>
    <% if @deliveries.empty? %>
      <p class="text-gray-400">Open an acquired ebook in your <%= link_to "library", library_index_path, class: "text-blue-400 hover:text-blue-300" %> and choose Send to Kobo.</p>
    <% end %>
    <% @deliveries.each do |delivery| %>
      <div class="border-t border-gray-800 py-4 flex flex-wrap justify-between gap-3" data-testid="kobo-delivery">
        <div class="min-w-0 flex-1 basis-64">
          <% if delivery.book&.acquired? %>
            <%= link_to delivery.publication["title"], library_path(delivery.book), class: "text-gray-200 hover:text-blue-400 break-words" %>
          <% else %>
            <p class="text-gray-200 break-words"><%= delivery.publication["title"] %></p>
          <% end %>
          <p class="text-sm text-gray-400 mt-1"><%= delivery.book&.acquired? ? (delivery.last_download_at ? "Download requested #{time_ago_in_words(delivery.last_download_at)} ago" : "Queued · waiting for download") : "Source removed from library · copy on reader kept" %></p>
          <% if @device.share_progress? || delivery.progress_bridge.present? %>
            <% place = kobo_place_notice(delivery, @progresses[delivery.book_id]) %>
            <p class="text-sm mt-1 <%= tones.fetch(place.tone) %>" data-testid="kobo-place"><%= place.text %></p>
          <% end %>
        </div>
        <div class="flex flex-wrap items-start gap-2">
          <% if place&.choosable %>
            <%= button_to "Use Kobo place", use_kobo_place_kobo_device_path(@device), params: { entitlement_id: delivery.entitlement_id }, form: { data: { turbo_confirm: "Resume #{delivery.publication['title']} at the Kobo place in Shelfarr's web and mobile readers?" } }, class: "rounded-lg bg-sky-800 px-3 py-2 text-sm text-white hover:bg-sky-700" %>
          <% end %>
          <% if delivery.book&.acquired? %>
            <%= button_to "Send again", send_book_kobo_device_path(@device), params: { book_id: delivery.book_id }, class: "rounded-lg bg-gray-800 px-3 py-2 text-sm text-gray-200 hover:bg-gray-700" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
  <section class="rounded-lg border border-gray-800 bg-gray-900 p-6" aria-labelledby="kobo-settings-heading">
    <h2 id="kobo-settings-heading" class="text-xl font-semibold text-white mb-4">Sync settings</h2>
    <% if @device.errors.any? %>
      <p role="alert" class="mb-4 text-red-400"><%= @device.errors.full_messages.to_sentence %></p>
    <% end %>
    <%= form_with model: @device, data: { turbo: false }, class: "space-y-4" do |form| %>
      <%= render "sync_options", form: form %>
      <% if @device.placeholder_auth_at && !@device.store_coexistence_was %>
        <p class="text-sm text-amber-300">This reader received Shelfarr's placeholder sign-in <%= time_ago_in_words(@device.placeholder_auth_at) %> ago. After keeping the Kobo Store, Kobo may ask it to sign in again; use the same Kobo account.</p>
      <% end %>
      <p class="text-sm text-gray-400">Changes apply at the reader's next sync. The connection address stays the same.</p>
      <%= form.submit "Save settings", class: "rounded-lg bg-blue-600 px-4 py-2 text-white hover:bg-blue-500 cursor-pointer" %>
    <% end %>
  </section>
  <section class="rounded-lg border border-gray-800 bg-gray-900 p-6 space-y-4">
    <h2 class="text-xl font-semibold text-white">Connection</h2>
    <p class="text-sm text-gray-400">Regenerating the address disables the previous one. Update the reader's configuration afterward. Revoking this connection keeps books already on the reader.</p>
    <p class="text-sm text-gray-400">To return to Kobo only, restore your saved <code>api_endpoint</code> line, or the stock <code class="break-all text-gray-300">api_endpoint=<%= KoboDevice::STORE_ENDPOINT %></code>.</p>
    <div class="flex flex-wrap gap-3">
      <%= button_to "Regenerate connection address", rotate_kobo_device_path(@device), form: { data: { turbo: false } }, class: "rounded-lg bg-gray-800 px-4 py-2 text-gray-200 hover:bg-gray-700" %>
      <%= button_to "Revoke connection", kobo_device_path(@device), method: :delete, data: { turbo_confirm: "Revoke this Kobo connection? The reader will stop syncing with Shelfarr." }, class: "rounded-lg bg-red-900 px-4 py-2 text-red-100 hover:bg-red-800" %>
    </div>
  </section>
</div>
