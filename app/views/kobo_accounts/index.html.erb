<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<div class="mx-auto max-w-3xl space-y-6">
  <%= link_to "← My profile", profile_path, class: "text-blue-400 hover:text-blue-300" %>
  <div>
    <h1 class="text-3xl font-bold text-white">Kobo accounts</h1>
    <p class="mt-2 text-gray-400">Connect your Kobo Store account to see its books in Shelfarr. Each connection and its catalogue are private to you until you choose to share them with someone in your household.</p>
  </div>
  <div class="rounded-lg border border-amber-800 bg-amber-950/30 p-5 text-sm text-amber-200">
    <p class="font-semibold">Household sharing preview</p>
    <p class="mt-2">Purchases that Kobo offers as DRM-free EPUBs can be sent to your own Kobo reader or to readers of people you share with. Protected purchases, Kobo Plus titles and previews can't be sent to another account's reader. Your physical Kobo and its settings stay unchanged.</p>
  </div>
  <% if @received_shares.any? %>
    <section class="rounded-lg border border-gray-800 bg-gray-900 p-5" aria-labelledby="kobo-shared-heading">
      <h2 id="kobo-shared-heading" class="text-lg font-semibold text-white">Shared with you</h2>
      <ul class="mt-2 divide-y divide-gray-800">
        <% @received_shares.each do |share| %>
          <li class="py-3 flex flex-wrap items-center justify-between gap-3">
            <div class="min-w-0">
              <%= link_to share.kobo_account.name, kobo_shared_library_path(share.kobo_account), class: "font-medium text-gray-100 hover:text-blue-400 break-words" %>
              <p class="text-sm text-gray-400 break-words">Shared by <%= share.kobo_account.user.name %></p>
            </div>
            <%= link_to "Browse", kobo_shared_library_path(share.kobo_account), class: "rounded-lg bg-gray-800 px-4 py-2 text-gray-200 hover:bg-gray-700" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
  <% @accounts.each do |account| %>
    <div class="rounded-lg border border-gray-800 bg-gray-900 p-5 flex flex-wrap items-center justify-between gap-4">
      <div class="min-w-0">
        <%= link_to account.name, kobo_account_path(account), class: "text-lg font-semibold text-white hover:text-blue-400 break-words" %>
        <p class="mt-1 text-sm text-gray-400"><%= account.connected? ? "Connected" : "Sign-in #{account.status.humanize.downcase}" %> · <%= (count = account.kobo_account_shares.size).zero? ? "private catalogue" : "shared with #{pluralize(count, 'person', plural: 'people')}" %></p>
      </div>
      <%= link_to "Manage account", kobo_account_path(account), class: "rounded-lg bg-gray-800 px-4 py-2 text-gray-200 hover:bg-gray-700" %>
    </div>
  <% end %>
  <section class="rounded-lg border border-gray-800 bg-gray-900 p-6">
    <h2 class="text-xl font-semibold text-white">Connect a Kobo account</h2>
    <p class="mt-2 mb-4 text-sm text-gray-400">You will get a code to approve on Kobo's website. Shelfarr never asks for your Kobo password. Your server stores the resulting connection credentials encrypted.</p>
    <%= form_with url: kobo_accounts_path, data: { turbo: false }, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :name, "Connection name", class: "block text-sm text-gray-300 mb-2" %>
        <%= form.text_field :name, required: true, maxlength: 80, value: "My Kobo account", class: "w-full rounded-lg border border-gray-700 bg-gray-800 px-4 py-2 text-white" %>
      </div>
      <%= form.submit "Connect Kobo account", class: "rounded-lg bg-blue-600 px-4 py-2 text-white hover:bg-blue-500 cursor-pointer" %>
    <% end %>
  </section>
  <p class="text-sm text-gray-400">To configure a physical reader, open <%= link_to "Kobo readers", kobo_devices_path, class: "text-blue-400 hover:text-blue-300" %>.</p>
</div>
