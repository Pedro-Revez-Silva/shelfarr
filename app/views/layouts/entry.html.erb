<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Shelfarr" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FBF7F0">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#16130F">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/web_app_head" %>
    <link rel="icon" href="<%= public_asset_path('icon.png') %>" type="image/png">
    <%= stylesheet_link_tag "web/preview", "entry" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body class="web-preview entry-app" data-turbo="false">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="auth-shell">
      <header class="auth-header">
        <%= link_to root_path, class: "wordmark", aria: { label: "Shelfarr" } do %>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M4 4h5v16H4zM10 7h4v13h-4zM16 4l4-1 3 16-4 1z"/></svg>
          shelfarr
        <% end %>
        <% if release_channel.beta? %><span class="preview-badge" title="<%= release_channel.label %>" data-release-badge>Beta</span><% end %>
      </header>
      <main id="main" class="auth-main<%= " auth-main--wide" if content_for?(:wide) %>">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
