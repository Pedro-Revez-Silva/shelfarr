<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Your library · Shelfarr" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "consumer", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body class="consumer-app">
    <a class="consumer-skip" href="#consumer-main">Skip to content</a>
    <header class="consumer-header">
      <%= link_to consumer_library_path, class: "consumer-wordmark", aria: { label: "Shelfarr library" } do %>
        <svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 4h5v16H4zM10 7h4v13h-4zM16 4l4-1 3 16-4 1z"/></svg>
        shelfarr<span class="consumer-preview">Reader preview</span>
      <% end %>
      <%= link_to profile_path, class: "consumer-avatar", aria: { label: "My profile" } do %><%= Current.user.name.first.upcase %><% end %>
    </header>
    <main id="consumer-main" class="consumer-main <%= content_for(:main_class) %>">
      <% flash.each do |kind, text| %><p role="status" class="consumer-notice"><%= text %></p><% end %>
      <%= yield %>
    </main>
    <% unless content_for?(:hide_navigation) %>
      <nav class="consumer-navigation" aria-label="Main navigation">
        <%= link_to "Library", consumer_library_path, aria: { current: "page" }, class: "is-active" %>
        <%= link_to "Discover", HardcoverIntegration.enabled? ? discover_path : search_path %>
        <%= link_to "Requests", requests_path %>
        <%= link_to "Account", profile_path %>
      </nav>
    <% end %>
  </body>
</html>
