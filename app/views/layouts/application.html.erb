<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Shelfarr" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Shelfarr">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <%= render "shared/web_app_head" %>
    <meta name="theme-color" content="#030712">

    <link rel="icon" href="<%= public_asset_path('icon.png') %>" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-950 min-h-screen">
    <% if authenticated? %>
      <noscript><style>[data-mobile-menu-target="menu"] { display: block; } [data-mobile-menu-target="button"] { display: none; }</style></noscript>
    <% end %>
    <nav class="bg-gray-900 border-b border-gray-800" aria-label="Main" data-controller="mobile-menu" data-action="keydown.esc->mobile-menu#dismiss">
      <% if authenticated? %>
        <% attention_count = Current.user&.admin? ? Request.needs_attention.count : Request.for_user(Current.user).needs_attention.count %>
        <% unread_count = Current.user&.notifications&.unread&.count || 0 %>
      <% end %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap justify-between items-center min-h-[4rem] gap-x-4 gap-y-2 py-2">
          <div class="flex items-center gap-6 min-w-0">
            <%= link_to root_path, class: "flex min-w-0 items-center gap-2 text-xl font-bold text-white" do %>
              <img src="<%= public_asset_path('icon.png') %>" alt="" class="w-8 h-8 shrink-0 rounded-md">
              <span class="truncate">Shelfarr</span>
              <% if release_channel.beta? %>
                <span class="shrink-0 rounded bg-amber-400/15 px-1.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-amber-300" title="<%= release_channel.label %>" data-release-badge>Beta</span>
              <% end %>
            <% end %>
            <% if authenticated? %>
              <div class="hidden lg:flex items-center gap-6">
                <%= navigation_link "Library", consumer_library_path, :library, class: "font-medium transition" %>
                <%= navigation_link "Discover", discover_entry_path, :discover, class: "font-medium transition" %>
                <div class="inline-flex items-center gap-2">
                  <%= navigation_link "Requests", requests_path, :requests, class: "font-medium transition" %>
                  <% if attention_count > 0 %>
                    <%= link_to requests_path(attention: "true"), class: "inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-red-500 hover:bg-red-400 text-white transition", aria: { label: "#{attention_count} #{'request'.pluralize(attention_count)} need attention" } do %>
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                      </svg>
                      <%= attention_count %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
          <div class="hidden lg:flex items-center gap-4">
            <% if authenticated? %>
              <% if allowed_to?(:index?, Upload) %>
                <%= navigation_link "Uploads", uploads_path, :uploads, class: "text-sm transition" %>
              <% end %>
              <% if Current.user&.admin? %>
                <%= navigation_link "Admin", admin_root_path, :admin, class: "text-sm transition" %>
              <% end %>
              <%= link_to notifications_path, class: "relative text-gray-400 hover:text-white transition", title: "Notifications", aria: { label: unread_count > 0 ? "Notifications, #{unread_count} unread" : "Notifications" } do %>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
                <% if unread_count > 0 %>
                  <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs font-bold w-5 h-5 flex items-center justify-center rounded-full" aria-hidden="true">
                    <%= unread_count > 9 ? '9+' : unread_count %>
                  </span>
                <% end %>
              <% end %>
              <%= link_to profile_path, class: "flex items-center gap-1 transition #{navigation_section == :account ? 'text-white underline decoration-blue-500 decoration-2 underline-offset-8' : 'text-gray-400 hover:text-white'}", title: "Account", aria: { current: ("page" if navigation_section == :account) } do %>
                <span><%= Current.user&.name %></span>
                <% if Current.user&.admin? %>
                  <span class="text-xs bg-purple-500/20 text-purple-400 px-2 py-1 rounded">Admin</span>
                <% end %>
              <% end %>
              <%= button_to "Sign out", session_path, method: :delete, class: "text-gray-400 hover:text-white transition" %>
            <% else %>
              <%= link_to "Sign in", new_session_path, class: "text-gray-400 hover:text-white transition" %>
              <% if User.active.none? %>
                <%= link_to "Sign up", sign_up_path, class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white" %>
              <% end %>
            <% end %>
          </div>
          <div class="flex lg:hidden items-center gap-2 shrink-0">
            <% if authenticated? %>
              <%= link_to notifications_path, class: "relative text-gray-400 hover:text-white transition p-1", title: "Notifications", aria: { label: unread_count > 0 ? "Notifications, #{unread_count} unread" : "Notifications" } do %>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
                <% if unread_count > 0 %>
                  <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs font-bold w-5 h-5 flex items-center justify-center rounded-full" aria-hidden="true">
                    <%= unread_count > 9 ? '9+' : unread_count %>
                  </span>
                <% end %>
              <% end %>
              <button type="button" class="text-gray-400 hover:text-white transition p-1" data-mobile-menu-target="button" data-action="mobile-menu#toggle" aria-label="Menu" aria-controls="main-menu" aria-expanded="false">
                <svg data-mobile-menu-target="openIcon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <svg data-mobile-menu-target="closeIcon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            <% else %>
              <%= link_to "Sign in", new_session_path, class: "text-gray-400 hover:text-white transition" %>
              <% if User.active.none? %>
                <%= link_to "Sign up", sign_up_path, class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white" %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <% if authenticated? %>
        <div id="main-menu" data-mobile-menu-target="menu" class="hidden lg:hidden border-t border-gray-800">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col">
            <%= navigation_link "Library", consumer_library_path, :library, class: "py-2 font-medium transition", data: { action: "mobile-menu#close" } %>
            <%= navigation_link "Discover", discover_entry_path, :discover, class: "py-2 font-medium transition", data: { action: "mobile-menu#close" } %>
            <div class="inline-flex items-center gap-2 py-2">
              <%= navigation_link "Requests", requests_path, :requests, class: "font-medium transition", data: { action: "mobile-menu#close" } %>
              <% if attention_count > 0 %>
                <%= link_to requests_path(attention: "true"), class: "inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-red-500 hover:bg-red-400 text-white transition", aria: { label: "#{attention_count} #{'request'.pluralize(attention_count)} need attention" }, data: { action: "mobile-menu#close" } do %>
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                  <%= attention_count %>
                <% end %>
              <% end %>
            </div>
            <% if allowed_to?(:index?, Upload) || Current.user&.admin? %>
              <div class="border-t border-gray-800 mt-2 pt-2 flex flex-col">
                <% if allowed_to?(:index?, Upload) %>
                  <%= navigation_link "Uploads", uploads_path, :uploads, class: "py-2 font-medium transition", data: { action: "mobile-menu#close" } %>
                <% end %>
                <% if Current.user&.admin? %>
                  <%= navigation_link "Admin", admin_root_path, :admin, class: "py-2 font-medium transition", data: { action: "mobile-menu#close" } %>
                <% end %>
              </div>
            <% end %>
            <div class="border-t border-gray-800 mt-2 pt-2 flex flex-col">
              <%= link_to profile_path, class: "py-2 flex items-center gap-2 transition #{navigation_section == :account ? 'text-white underline decoration-blue-500 decoration-2 underline-offset-8' : 'text-gray-300 hover:text-white'}", aria: { current: ("page" if navigation_section == :account) }, data: { action: "mobile-menu#close" } do %>
                <span>Account</span>
                <span class="text-sm text-gray-500"><%= Current.user&.name %></span>
                <% if Current.user&.admin? %>
                  <span class="text-xs bg-purple-500/20 text-purple-400 px-2 py-1 rounded">Admin</span>
                <% end %>
              <% end %>
              <%= button_to "Sign out", session_path, method: :delete, class: "py-2 text-left text-gray-300 hover:text-white font-medium transition" %>
            </div>
          </div>
        </div>
      <% end %>
    </nav>

    <main class="max-w-7xl mx-auto mt-8 px-4 sm:px-6 lg:px-8 pb-12">
      <%= yield %>
    </main>

    <%# Toast notifications - bottom right, auto-dismiss %>
    <div id="flash" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm">
      <%= render "shared/flash" %>
    </div>
  </body>
</html>
