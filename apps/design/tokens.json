{
  "$comment": "Single source of truth for the Shelfarr reading brand. apps/scripts/check-design-tokens.py keeps Android, iOS and these values in step and enforces contrast.",
  "color": {
    "light": {
      "background": "#FBF7F0",
      "surface": "#FFFDF9",
      "sunken": "#F3ECE0",
      "ink": "#211C16",
      "inkMuted": "#665B4E",
      "hairline": "#E6DCCB",
      "accent": "#A33A22",
      "onAccent": "#FFF9F2",
      "accentSoft": "#F6E3D8",
      "danger": "#9B1C1C"
    },
    "dark": {
      "background": "#16130F",
      "surface": "#211C17",
      "sunken": "#0F0D0A",
      "ink": "#F2EADD",
      "inkMuted": "#B3A797",
      "hairline": "#38302A",
      "accent": "#EE9270",
      "onAccent": "#2B1208",
      "accentSoft": "#3D261C",
      "danger": "#F2A3A3"
    }
  },
  "reader": {
    "paper": { "page": "#FBF7F0", "text": "#2A241D", "muted": "#665B4E", "bar": "#FFFDF9", "hairline": "#E6DCCB", "accent": "#A33A22" },
    "sepia": { "page": "#F0E5D0", "text": "#3A2E21", "muted": "#65553F", "bar": "#F7EEDD", "hairline": "#DCCDB1", "accent": "#96351F" },
    "night": { "page": "#16130F", "text": "#D9CFC0", "muted": "#A99D8D", "bar": "#211C17", "hairline": "#38302A", "accent": "#EE9270" }
  },
  "cover": {
    "ink": "#F7EFE2",
    "swatches": ["#6E2A20", "#3F4A30", "#26384A", "#7A5518", "#4E2F44", "#3F4649"]
  },
  "radius": { "cover": 4, "coverLarge": 8, "control": 12, "card": 18 },
  "spacing": { "gutter": 20, "readingGutter": 24, "shelfGap": 14, "gridMinCell": 104, "shelfCell": 112 },
  "type": {
    "display": "Newsreader Display 500, tracking -0.2 to -0.6",
    "serif": "Newsreader 400/600 for titles, descriptions and book text",
    "interface": "system sans (Roboto / SF / system-ui)",
    "minimumTouchTarget": 48
  }
}
