#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
scratch_root="${SHELFARR_MIGRATION_SCRATCH:-${TMPDIR:-$HOME/.cache/agent-tmp}}"
case "$scratch_root" in
  /tmp | /tmp/* | /dev/shm | /dev/shm/*) echo "refusing RAM-backed scratch: $scratch_root" >&2; exit 2 ;;
esac
mkdir -p "$scratch_root"
work="$(mktemp -d "$scratch_root/shelfarr-migration.XXXXXX")"
keep="${SHELFARR_MIGRATION_KEEP:-}"
cleanup() { [ -n "$keep" ] || rm -rf "$work"; }
trap cleanup EXIT

marker="$work/start-marker"
touch "$marker"
sleep 1

wanted_ruby="$(tr -d '[:space:]' < "$root/.ruby-version")"
case "$(ruby -e 'print RUBY_VERSION')" in
  "$wanted_ruby") ;;
  *) echo "Ruby $wanted_ruby from .ruby-version must be first on PATH" >&2; exit 2 ;;
esac

step() { printf '\n== %s\n' "$*"; }

clean_env() {
  env -i HOME="$HOME" PATH="$PATH" LANG=C.UTF-8 "$@"
}

produce() {
  (cd "$root" && clean_env timeout 900 bundle exec ruby tools/migration/produce_fixture.rb --out "$@")
}

step "ruby: isolation guard tests, release resolver, upgrade verifier and style"
(cd "$root" && bundle exec ruby -Itest tools/migration/test/fixture_isolation_test.rb)
(cd "$root" && bundle exec ruby -Itest tools/migration/test/produce_isolation_test.rb)
(cd "$root" && bundle exec ruby -Itest tools/migration/test/release_source_test.rb)
(cd "$root" && bundle exec ruby -Itest tools/migration/test/upgrade_verification_test.rb)
step "ruby: stable-upgrade scenarios (failed, killed and late migrations, bypasses, tampering) under a time limit"
(cd "$root" && timeout 900 bundle exec ruby -Itest tools/migration/test/stable_upgrade_test.rb)
(cd "$root" && bin/rubocop --force-exclusion tools/migration)

step "ruby: produce fixture bundles from the real Rails code (twice)"
produce "$work/bundle-a"
produce "$work/bundle-b"

step "ruby: upgrade the released v2026.11.05.1 primary database with the shipped migrations (twice)"
produce "$work/upgrade-a" --mode stable-upgrade
produce "$work/upgrade-b" --mode stable-upgrade

step "ruby: producing touched nothing in the repository"
changed="$(find "$root" -newer "$marker" -not -path "$root/.git" -not -path "$root/.git/*" 2>/dev/null || true)"
if [ -n "$changed" ]; then
  echo "repository files changed while producing fixtures:" >&2
  echo "$changed" >&2
  exit 1
fi

step "reproducibility: independent runs agree on schema, coverage and layout"
python3 - "$work" <<'PY'
import json, sys
work = sys.argv[1]
def load(name, document):
    return json.load(open(f"{work}/{name}/{document}"))
def shape(manifest):
    return {
        "format": manifest["fixture_format"], "origin": manifest["origin"], "schema": manifest["schema"],
        "digest": manifest["coverage"]["digest"], "cases": manifest["coverage"]["cases"], "gaps": manifest["coverage"]["gaps"],
        "files": sorted(manifest["files"]),
        "trees": [(tree["name"], sorted(tree["files"]), tree["symlinks"] and sorted(tree["symlinks"])) for tree in manifest["external_trees"]],
        "producer": {key: value for key, value in manifest["producer"].items()},
    }
def upgrade_shape(evidence):
    return {key: evidence[key] for key in ("release", "migrations_applied", "preserved")} | {"schema": {key: evidence["schema"][key] for key in ("before_revision", "after_revision")}, "post_upgrade": {key: evidence["post_upgrade"][key] for key in ("rows_added", "preserved_rows_changed_total")}}
for left, right in (("bundle-a", "bundle-b"), ("upgrade-a", "upgrade-b")):
    if shape(load(left, "manifest.json")) != shape(load(right, "manifest.json")):
        raise SystemExit(f"fixture shape differs between independent runs: {left} {right}")
if upgrade_shape(load("upgrade-a", "expected/stable-upgrade.json")) != upgrade_shape(load("upgrade-b", "expected/stable-upgrade.json")):
    raise SystemExit("upgrade evidence differs between independent runs")
current, upgraded = load("bundle-a", "manifest.json"), load("upgrade-a", "manifest.json")
if current["origin"] != "current-schema" or upgraded["origin"] != "stable-upgrade" or current["schema"]["revision"] != upgraded["schema"]["revision"]:
    raise SystemExit("producer modes are not distinguishable by origin and schema revision")
print("coverage digest", current["coverage"]["digest"], "cases", len(current["coverage"]["cases"]))
print("upgrade digest", upgraded["coverage"]["digest"], "cases", len(upgraded["coverage"]["cases"]))
PY

cd "$root/apps/server"
step "go: format, vet, unit tests with the race detector"
test -z "$(gofmt -l .)"
go vet ./...
go vet -tags e2e ./...
go test -race -count=1 ./...

step "go: end-to-end executable tests, negative controls and mutants"
SHELFARR_COMPAT_BUNDLE="$work/bundle-a" SHELFARR_COMPAT_UPGRADE_BUNDLE="$work/upgrade-a" go test -tags e2e -count=1 -timeout 20m -parallel 4 -v ./e2e/ | tee "$work/e2e.log" | grep -E '^(=== RUN|--- (PASS|FAIL)|PASS|FAIL|ok)' | grep -vE '^=== RUN' | grep -E 'FAIL|^ok|^PASS' || true
grep -q '^ok' "$work/e2e.log" || { cat "$work/e2e.log" >&2; exit 1; }

step "go: race-instrumented executable against every independent bundle, including the upgraded ones"
CGO_ENABLED=1 go build -race -trimpath -o "$work/compat-race" ./cmd/shelfarr-compat
for bundle in bundle-a bundle-b upgrade-a upgrade-b; do
  "$work/compat-race" compat-check --bundle "$work/$bundle" --legacy-sha1 --timeout 300s | python3 -c 'import json,sys; r=json.load(sys.stdin); assert r["passed"], r; print("passed", [c["name"] for c in r["checks"]])'
done

step "go: clean cross-builds for the architectures the image supports"
for arch in amd64 arm64; do
  CGO_ENABLED=0 GOOS=linux GOARCH="$arch" go build -trimpath -buildvcs=false -ldflags="-s -w" -o "$work/compat-$arch" ./cmd/shelfarr-compat
  CGO_ENABLED=0 GOOS=linux GOARCH="$arch" go build -trimpath -buildvcs=false -ldflags="-s -w" -o "$work/compat-$arch.again" ./cmd/shelfarr-compat
  cmp "$work/compat-$arch" "$work/compat-$arch.again"
  printf '%s %s\n' "$arch" "$(sha256sum "$work/compat-$arch" | cut -d' ' -f1)"
done

step "repository untouched after the whole run"
changed="$(find "$root" -newer "$marker" -not -path "$root/.git" -not -path "$root/.git/*" 2>/dev/null || true)"
if [ -n "$changed" ]; then
  echo "repository files changed during verification:" >&2
  echo "$changed" >&2
  exit 1
fi
echo "verification passed"
